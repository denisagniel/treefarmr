# Makevars.win for Windows

# Set C++ standard
CXX_STD = CXX11

# Compiler flags
PKG_CPPFLAGS = -I../inst/include -DNOMINMAX
# CRITICAL FIX: Prevent Rcpp global stream initialization during static init
PKG_CPPFLAGS += -URCPP_USE_GLOBAL_ROSTREAM
PKG_CXXFLAGS = -DNOMINMAX

# Link against required libraries
PKG_LIBS = -lgmp

# CRITICAL FIX: Explicitly exclude RcppParallel/TBB libraries
# R's build system may auto-link RcppParallel when Rcpp is in LinkingTo,
# but we don't use TBB (removed in favor of std::unordered_map with mutex).
# Filter out TBB libraries to prevent unnecessary linking.
PKG_LIBS := $(filter-out -ltbb -ltbbmalloc,$(PKG_LIBS))

# Include directories
PKG_CPPFLAGS += -I../inst/include

# Remove main.cpp from compilation (it's for CLI, not library)
SOURCES = $(wildcard *.cpp)
SOURCES := $(filter-out main.cpp, $(SOURCES))

# Add ckmeans library object files (for k-means lower bounds)
# R's build system doesn't automatically recurse into subdirectories,
# so we need to explicitly add object files from lib/ckmeans/
OBJECTS = $(SOURCES:.cpp=.o) \
          lib/ckmeans/Ckmeans.1d.dp.o \
          lib/ckmeans/dynamic_prog.o \
          lib/ckmeans/fill_log_linear.o \
          lib/ckmeans/fill_quadratic.o \
          lib/ckmeans/fill_SMAWK.o

# Build standalone executable for process isolation (Windows)
# Create inst/bin directory if it doesn't exist.
#
# NOTE: this recipe is executed by `sh` (Rtools/MSYS2), not cmd.exe -- R's
# Windows build system runs every Makevars.win recipe line through the same
# shell as Makevars, it does not switch to cmd.exe just because the file is
# named .win. `if not exist X mkdir X` is cmd.exe batch syntax; sh cannot
# parse it and fails with "syntax error: unexpected end of file" (an
# unterminated `if` from sh's point of view), which aborted the ENTIRE
# install here, after the actual .dll had already linked successfully.
# `mkdir -p` is understood by MSYS2's sh/coreutils and is a no-op if the
# directory already exists, matching the original's intent portably.
all: $(SHLIB)
	@mkdir -p ../inst/bin
	@echo Building standalone gosdt executable...
	$(CXX) $(PKG_CPPFLAGS) $(PKG_CXXFLAGS) $(CXXFLAGS) -o ../inst/bin/gosdt.exe \
		main.cpp $(filter-out rcpp_treefarms.cpp RcppExports.cpp, $(wildcard *.cpp)) \
		$(PKG_LIBS) $(LDFLAGS)
	@echo Standalone executable built: ../inst/bin/gosdt.exe